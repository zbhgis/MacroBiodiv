# 构建产物（部署包，不入库 —— 随时可由 build_site.py 重新生成）
site/
site_trash/

# Python
__pycache__/
*.pyc

# 跨进程文件锁（admin.save_papers ↔ prepare_thumbs 写 papers.json 互斥）
meta/.papers.lock

# 系统垃圾文件
.DS_Store
Thumbs.db

# 本地工具与临时文件
.trae/
.zcode/
debug.log

# 周报回收站（管理界面软删除的本机暂存，不进仓库；已发布周报在 git 历史里仍有底）
content/.trash/

# 周报编辑备份（管理界面写回前的单份回退点，不进仓库）
*.md.bak
